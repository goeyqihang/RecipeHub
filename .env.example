# Copy this file to .env and fill in your own values. .env is git-ignored.

# Port the Express server listens on
PORT=8080

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/recipeHubDB

# Secret used to sign login tokens (JWTs). Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If it is empty, the server picks a random secret at startup, so every restart logs everyone out.
JWT_SECRET=

# How long a login stays valid (default: 7d)
# JWT_EXPIRES_IN=7d

# Maximum login/registration requests per IP every 15 minutes (default: 20)
# AUTH_RATE_LIMIT=20

# Google Gemini API key (create one in Google AI Studio).
# Used for the AI health analysis. Optional: the rest of the app works without it.
GEMINI_API_KEY=

# Path to a Google Cloud service-account key file (JSON) for a project with the
# Cloud Translation API and Cloud Text-to-Speech API enabled.
# Used for recipe translation and read-aloud. Optional, like the key above.
# Keep the key outside the repository, or in the git-ignored credentials/ folder, e.g.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
