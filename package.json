{
  "name": "recipe-hub",
  "version": "1.0.0",
  "description": "Full-stack recipe and kitchen-inventory manager with AI health analysis, translation and read-aloud",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node backend/server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "nodemon --watch backend backend/server.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest",
    "test:frontend": "ng test --watch=false --browsers=ChromeHeadlessCI"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.6",
    "@angular/compiler": "^20.3.6",
    "@angular/core": "^20.3.6",
    "@angular/forms": "^20.3.6",
    "@angular/platform-browser": "^20.3.6",
    "@angular/router": "^20.3.6",
    "@angular/service-worker": "^20.3.6",
    "@google-cloud/text-to-speech": "^6.3.1",
    "@google-cloud/translate": "^9.2.1",
    "@google/generative-ai": "^0.24.1",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.1",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.4",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.6",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "jest": "^30.5.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.0",
    "typescript": "~5.9.2"
  }
}
